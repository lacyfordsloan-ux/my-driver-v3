generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
}

enum RideStatus {
  PENDING
  ACCEPTED
  CANCELLED
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

model User {
  id          String    @id @default(cuid())
  phone       String    @unique
  role        Role      @default(PASSENGER)
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rideRequests RideRequest[]  @relation("PassengerRides")
  offers       Offer[]        @relation("DriverOffers")
  messages     ChatMessage[]
  subscriptions Subscription[]

  @@map("users")
}

model Settlement {
  id        String    @id @default(cuid())
  name      String
  latitude  Float?
  longitude Float?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("settlements")
}

model RideRequest {
  id           String     @id @default(cuid())
  passengerId  String     @map("passenger_id")
  passenger    User       @relation("PassengerRides", fields: [passengerId], references: [id])
  fromName     String     @map("from_name")
  toName       String     @map("to_name")
  fromLat      Float?     @map("from_lat")
  fromLng      Float?     @map("from_lng")
  toLat        Float?     @map("to_lat")
  toLng        Float?     @map("to_lng")
  status       RideStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  offers       Offer[]
  messages     ChatMessage[]

  @@map("ride_requests")
}

model Offer {
  id            String      @id @default(cuid())
  rideRequestId String      @map("ride_request_id")
  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id])
  driverId      String      @map("driver_id")
  driver        User        @relation("DriverOffers", fields: [driverId], references: [id])
  price         Float?
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  @@map("offers")
}

model ChatMessage {
  id            String      @id @default(cuid())
  rideRequestId String      @map("ride_request_id")
  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id])
  senderId      String      @map("sender_id")
  sender        User        @relation(fields: [senderId], references: [id])
  text          String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("chat_messages")
}

model Subscription {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id])
  status            PaymentStatus @default(PENDING)
  amount            Float
  yookassaPaymentId String?       @map("yookassa_payment_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("subscriptions")
}
